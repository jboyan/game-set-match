{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Streamlit: app.py",
      "type": "python",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "${workspaceFolder}/app.py", "--server.port=8501"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src${pathSeparator}${env:PYTHONPATH}",
        "STREAMLIT_BROWSER_GATHER_USAGE_STATS": "false"
      }
    }
  ]
}
